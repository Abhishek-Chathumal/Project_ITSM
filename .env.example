# Postgres
POSTGRES_USER=itsm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=itsm
DATABASE_URL=postgresql://itsm:change-me@localhost:5432/itsm

# Redis
REDIS_URL=redis://localhost:6379

# API
NODE_ENV=development
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# Web
WEB_PORT=5173
# Relative on purpose: the browser calls the dev server (or nginx in prod), which
# proxies /api onward. Keeps dev and prod on the same origin — no CORS round trip.
VITE_API_BASE_URL=/api/v1

# Seed (dev/test only — never set these in a real deployment's committed config)
SEED_BOOTSTRAP_ADMIN=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
